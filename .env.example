APP_NAME="Union Trading"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Em produção: APP_ENV=production e APP_DEBUG=false (nunca deixe DEBUG=true
# em produção — isso vaza stack trace, caminhos de arquivo e variáveis de
# ambiente para qualquer erro exibido no navegador).
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=union_trading
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Em produção (servindo por HTTPS), mude para true:
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# E-mail. Em DESENVOLVIMENTO deixe MAIL_MAILER=log (as mensagens caem em
# storage/logs/laravel.log) OU use o Mailpit do Laragon com MAIL_MAILER=smtp
# e MAIL_PORT=1025.
# Em PRODUÇÃO configure um provedor real (SMTP do domínio, Amazon SES,
# Mailgun...) para que "Esqueci minha senha" e o e-mail de credenciais do
# usuário criado/reset pelo admin cheguem de verdade. Exemplo SMTP:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.seuprovedor.com
#   MAIL_PORT=587
#   MAIL_USERNAME=...   MAIL_PASSWORD=...   MAIL_ENCRYPTION=tls
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="nao-responda@utrading.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Usados apenas pelo AdminUserSeeder (php artisan db:seed) para criar o
# PRIMEIRO administrador. Depois disso, todo usuário é criado pelo painel
# admin — remova/esqueça estas duas linhas após rodar o seeder.
ADMIN_EMAIL=admin@uniontrading.com.br
ADMIN_PASSWORD=
